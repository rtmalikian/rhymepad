{
  "name": "rhymepad",
  "version": "0.1.0",
  "private": true,
  "description": "A Dockerized rhyming dictionary, rhyme scheme visualizer, syllable counter, and songwriting notepad for rap lyrics and poetry.",
  "author": "Raphael Malikian <rtmalikian@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "npm run build && cap sync",
    "android:debug": "bash scripts/build-android-debug.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "playwright test tests/readme-screenshots.spec.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@vitejs/plugin-react": "^5.0.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.1",
    "syllable": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.0"
  }
}
